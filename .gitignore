# 依赖与构建产物
node_modules/
out/
dist/
release-dev/
release/
release2/
release3/
release4/
release5/
release6/
release7/

# 换肤脚本运行时产物：含本机路径与体积较大的备份，不入库
backups/
*-manifest.json
# 候选身份登记是发布链核心事实源，必须入库（上面的通配规则不适用于它）
!candidate-manifest.json
app.*.asar
# WorkBuddy 工作数据（会话记忆与日志）
.workbuddy/
test-results/
playwright-report/
*.log
probe.log
# 本地诊断产物：跑一次生成一份，内容是本机路径，不入库
tools/*result*.json
tools/post-restore-health.json
tools/*.png
# 本地界面截图：可用 node tools/capture-ui.cjs 重新生成，不入库
handoff/images/

# Alpha 候选构建目录（含版本号，便于分发时直接识别）
candidate-*/
candidate-*.zip
candidate-*.txt
# 历史候选归档区（迁移中，内容同上，不入库）
ago/
ago$B/

# 复审/诊断夹具：内含嵌套 .git 与 .asar/.exe 构建产物，只保留文本证据
handoff/review-*/evidence*/fixture/
handoff/review-*/evidence*/fixture/.git/
# 复审复现器每次运行新建的临时夹具（如 handoff/review-2026-09-16-r2/reproduce.cjs）：
# 内容是可重复生成的合成 zip 与 results.json，保留在磁盘但不入库
handoff/review-*/fixtures-*/



# out 目录快照归档：构建产物压缩包，内容含本机绝对路径，不入库
handoff/**/archive/*.tar.gz
