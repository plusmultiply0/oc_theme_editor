{
  "name": "opencode-theme-switcher",
  "version": "0.1.0-alpha.4",
  "author": "jc",
  "license": "MIT",
  "private": true,
  "description": "本地运行的 Windows OpenCode 桌面换肤助手：选图、取色、调节、预览、应用与恢复。",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.local.opencode-theme-switcher",
    "productName": "OpenCodeThemeSwitcher",
    "directories": {
      "output": "release-dev"
    },
    "files": [
      "out/**",
      "package.json",
      "LICENSE",
      "node_modules/**"
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "npmRebuild": false,
    "removePackageScripts": true
  },
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:electron": "node tools/run-electron-e2e.cjs",
    "verify": "node tools/verify-entry.cjs",
    "verify:steps": "node tools/verify-entry.cjs --list",
    "release:build": "node tools/release-build.cjs build",
    "release:verify": "node tools/release-build.cjs verify",
    "release:gate": "bash tools/release-gate.sh",
    "verify:package": "node tools/verify-package.cjs",
    "verify:release": "node tools/verify-release.cjs",
    "test:gate": "node tools/test-release-gate.cjs",
    "test:cleanup-semantics": "node tools/n5-crossproc-cleanup.cjs",
    "dist": "npm run build && electron-builder --win --dir",
    "smoke": "electron tools/smoke-main.cjs",
    "audit": "node tools/audit.cjs"
  },
  "dependencies": {
    "@electron/asar": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.29.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
